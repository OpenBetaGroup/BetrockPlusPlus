{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "client-debug",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "client-release",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "client-release-with-debug-info",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "client-minsize",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "OFF",
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "server-debug",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "server-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "server-release-with-debug-info",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "server-release-with-debug-info-optionals",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BETACRAFT_HEARTBEAT": "ON",
        "VCPKG_MANIFEST_FEATURES": "betacraft-heartbeat"
      }
    },
    {
      "name": "server-minsize",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ]
}