{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "server-debug",
      "description": "Debug build (slow)",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "BPP_CHECK_LICENSE_HEADERS": "OFF"
      }
    },
    {
      "name": "server-ci",
      "description": "CI profile (does lots of extra checks, slow)",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "server-dev",
      "description": "Release build without LTO (moderately fast)",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BPP_CHECK_LICENSE_HEADERS": "OFF"
      }
    },
    {
      "name": "server-minsize",
      "description": "Release build with small binary size (fast + small)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "BPP_CHECK_LICENSE_HEADERS": "OFF"
      }
    },
    {
      "name": "server-release",
      "description": "Release build (fastest)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "BUILD_SERVER": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BPP_CHECK_LICENSE_HEADERS": "OFF"
      }
    }
  ]
}